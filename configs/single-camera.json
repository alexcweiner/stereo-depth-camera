{
  "network": {
    "bind_address": "0.0.0.0:8080"
  },
  "modules": [
    {
      "name": "stereo-depth",
      "type": "local",
      "executable_path": "/app/bin/run-module"
    }
  ],
  "components": [
    {
      "name": "rig",
      "api": "rdk:component:camera",
      "model": "webcam",
      "attributes": {
        "video_path": "0",
        "format": "MJPEG",
        "width_px": 2560,
        "height_px": 720,
        "frame_rate": 30
      }
    },
    {
      "name": "cam-left",
      "api": "rdk:component:camera",
      "model": "transform",
      "attributes": {
        "source": "rig",
        "pipeline": [
          {
            "type": "crop",
            "attributes": {
              "x_min_px": 0.0,
              "y_min_px": 0.0,
              "x_max_px": 0.5,
              "y_max_px": 1.0,
              "overlay_crop_box": false
            }
          }
        ]
      }
    },
    {
      "name": "cam-right",
      "api": "rdk:component:camera",
      "model": "transform",
      "attributes": {
        "source": "rig",
        "pipeline": [
          {
            "type": "crop",
            "attributes": {
              "x_min_px": 0.5,
              "y_min_px": 0.0,
              "x_max_px": 1.0,
              "y_max_px": 1.0,
              "overlay_crop_box": false
            }
          }
        ]
      }
    },
    {
      "name": "cam-depth",
      "api": "rdk:component:camera",
      "model": "local:stereo-depth:camera",
      "attributes": {
        "source": "rig",
        "focal_px": 700,
        "baseline_mm": 60
      }
    }
  ]
}
