{
  "network": {
    "bind_address": "0.0.0.0:8080"
  },
  "modules": [
    {
      "name": "stereo-depth",
      "type": "local",
      "executable_path": "/app/bin/run-module",
      "env": {
        "STEREO_DEPTH_WEBRTC": "1"
      }
    }
  ],
  "components": [
    {
      "name": "cam",
      "api": "rdk:component:camera",
      "model": "local:stereo-depth:camera",
      "attributes": {
        "stream_id": "cam",
        "focal_px": 700,
        "baseline_mm": 60
      }
    },
    {
      "name": "cam-left",
      "api": "rdk:component:camera",
      "model": "transform",
      "attributes": {
        "source": "cam",
        "pipeline": [
          {
            "type": "crop",
            "attributes": {
              "x_min_px": 0.0,
              "y_min_px": 0.0,
              "x_max_px": 0.5,
              "y_max_px": 1.0,
              "overlay_crop_box": false
            }
          }
        ]
      }
    },
    {
      "name": "cam-right",
      "api": "rdk:component:camera",
      "model": "transform",
      "attributes": {
        "source": "cam",
        "pipeline": [
          {
            "type": "crop",
            "attributes": {
              "x_min_px": 0.5,
              "y_min_px": 0.0,
              "x_max_px": 1.0,
              "y_max_px": 1.0,
              "overlay_crop_box": false
            }
          }
        ]
      }
    }
  ]
}
